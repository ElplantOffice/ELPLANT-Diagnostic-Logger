{
  "ApplicationName": "ELPLANT Diagnostic Logger",

  "SystemName": "TEST Machine",

  "Storage": {
    "DatasetFolder": "C:\\ELPLANT\\DiagnosticLogger\\Data",
    "ApplicationLogFolder": "C:\\ELPLANT\\DiagnosticLogger\\Logs",
    "WriteIntervalSeconds": 10,
    "ApplicationLogRetentionDays": 30
  },

  "Plcs": [
    {
      "Name": "TRL Mahindra",

      "Enabled": true,

      "AmsNetId": "192.168.0.151.1.1",

      "Port": 852,

      "ConnectTimeoutMs": 5000,

      "ReadTimeoutMs": 2000,

      "ReconnectIntervalSeconds": 10,

      "RetentionDays": 10,

      "Parameters": [
        {
          "Name": "MachineRunning",
          "VarAddress": "App_Variables.g_tApp.tCond.bProductionRunning",
          "ReadMode": "OnChange"
        },
        {
          "Name": "AxisPosition",
          "VarAddress": "App_Variables.tAxisRef[1].NcToPlc.ActPos",
          "VarType": "System.Double",
          "ReadMode": "Periodic",
          "ReadIntervalMs": 1000
        }
      ]
    }
  ]
}