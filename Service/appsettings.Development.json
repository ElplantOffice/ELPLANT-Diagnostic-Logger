{
  "ApplicationName": "ELPLANT Diagnostic Logger",

  "SystemName": "TEST Machine",

  "Storage": {
    "DatasetFolder": "C:\\ELPLANT\\DiagnosticLogger\\Data",
    "ApplicationLogFolder": "C:\\ELPLANT\\DiagnosticLogger\\Logs",
    "WriteIntervalSeconds": 10
  },

  "Ads": {
    "ConnectTimeoutSeconds": 5,
    "ReadTimeoutSeconds": 2,
    "ReconnectIntervalSeconds": 10
  },

  "Acquisition": {
    "DefaultPeriodicReadIntervalSeconds": 10
  },

  "Plcs": [
    {
      "Name": "TRL Mahindra",

      "Enabled": true,

      "AmsNetId": "192.168.0.151.1.1",

      "Port": 852,

      "RetentionDays": 10,

      "Parameters": [
        {
          "Name": "MachineRunning",
          "VarAddress": "App_Variables.g_tApp.tCond.bProductionRunning",
          "VarType": "System.Boolean",
          "ReadMode": "OnChange"
        },
        {
          "Name": "AxisPosition1",
          "VarAddress": "App_Variables.tAxisRef[1].NcToPlc.ActPos",
          "VarType": "System.Double",
          "ReadMode": "OnChange",
          "Offset": 1.0
        },
        {
          "Name": "AxisPosition3",
          "VarAddress": "App_Variables.tAxisRef[3].NcToPlc.ActPos",
          "VarType": "System.Double",
          "ReadMode": "Periodic",
          "Offset": 1.0,
          "ForceWriteIntervalSeconds": 60
        }
      ]
    },
    {
      "Name": "Test FTN",

      "Enabled": true,

      "AmsNetId": "192.168.0.167.1.1",

      "Port": 851,

      "RetentionDays": 10,

      "Parameters": [
        {
          "Name": "BoolTest",
          "VarAddress": "MAIN.iTestVar2",
          "VarType": "System.Boolean",
          "ReadMode": "OnChange"
        },
        {
          "Name": "IntTest",
          "VarAddress": "MAIN.iTestVar",
          "VarType": "System.Int16",
          "ReadMode": "Periodic"
        }
      ]
    }
  ]
}